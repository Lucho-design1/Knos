{"v": 2, "kind": "knos-demand-check", "limits": "Qloo states no prices, no market sizes, no B2B and no medical demand; the only price signals are venue price levels (1-4) and spending-habit segments. Pre-orders and per-use payments are how willingness to pay is proven here.", "idea": "a plant-based burger chain", "place": null, "leader_named": null, "label": "NO QLOO EVIDENCE", "framing": "Directional demand evidence, not a sales forecast.", "aggregate": "aggregate taste, not a prediction about one person", "product_type": null, "words": ["plant-based", "burger", "chain"], "matches": [], "unrelated": [], "excluded": [], "leader": null, "tags": [], "who": null, "where": [], "places": [], "audiences": [], "trend": null, "versus": null, "named_audience": [], "buyer_group": null, "recommended": null, "cities": [], "price": null, "persona": [], "persona_all": [], "ladder": [], "tag_families": [], "decision": {"verdict": "CANNOT_DECIDE", "reasons": ["cannot decide: no Qloo evidence", "no Qloo API key on this server"], "target_units": null, "reserve_units": null}, "rules": {"relevance": "a Qloo product counts only when its name shares 2 content words with the idea, or 1 in its name and 1 more in its description or tags, or 3 anywhere in its name, description and tags (content words: the idea minus filler, pitch, instruction and kind words such as podcast); none -> REFUSE no product in Qloo matches this idea", "clone": "the leader's name is in the idea together with a clone phrase ('exactly like', 'clone of', ...) or is the idea's whole subject -> REFUSE an existing product already owns this", "informative_affinity": 0.55, "min_informative_segments": 3, "served_overlap": 0.85, "owned_overlap": 0.6, "owned_popularity": 0.95, "unknown_leader_popularity": 0.9, "min_compare_tags": 3, "contradiction": -0.3, "falling_delta": -0.02, "rising_delta": 0.02, "group_confirmed": 1.2, "group_refuted": 0.6, "adjacent_affinity": 0.94, "adjacent_many": 5, "adjacent_many_factor": 1.2, "adjacent_few": 1, "adjacent_few_factor": 0.8, "base_units": 100, "units_formula": "target = round10(base x (1 + 2 x strength) x (1 - overlap/2) x audience_factor x trend_factor), strength = mean (affinity - 0.5) x 2 of the informative segments, trend_factor 1.25 rising else 1, audience_factor = 0.5 when the named audience leans mildly away (else 1) x the buyer-group factor x the recommendations factor (see group_* and adjacent_*), clamped to [20, 1000]; reserve = ceil(target x (0.3 + 0.2 x overlap)) units pre-ordered before the maker is paid"}, "calls": [], "made": "2026-10-23T12:38:36Z", "day": "2026-10-23", "options": {}, "grounding": {}, "hash": "3e187a428717b31fd37061717a1ae5ef9b31836576a22526ef38d5ead609df6d", "fees": {"rate_bps": 30, "percent": 0.3, "floor": "0.05", "status": "live", "funding_fee_bps": 0, "graduation": {"rate_bps": 50, "status": "decided", "collected": "by contract, off chain, until a knos_pay build carries it (a program upgrade); on chain today only the payout fee is taken"}, "text": "Knos takes 0.3% (at least 0.05 test units) only on money released on proof; a refund costs the buyer nothing", "source": "config/fees.yaml (fees.payout, fees.funding)"}, "record": {"recorded": false, "why": "CapExceededError: You're at the 5 MB free-tier cap and your account isn't activated. Run `sibyl init` to activate, or stay under the cap."}, "elapsed_ms": 4035}