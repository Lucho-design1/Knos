knos: 1
name: knos-playground-judge
description: Demo on the Knos repository itself (read-only, commit 99cc4e3e). The playground judge catches every wrong solution in tasks/
entry: python3 @DIR@/caught.py --split {split} --seed {seed} --data {data} --out {out}
data:
  generator: python3 @DIR@/seed.py --seed {data_seed} --out {data}
  seed: 111
  protected: [tasks/]
claims:
  - id: wrong_caught
    metric: wrong_caught_rate
    expected: 1.0
    tolerance: 0
  - id: reference_ok
    metric: reference_ok_rate
    expected: 1.0
    tolerance: 0
compute:
  max_seconds: 300
authors:
  - github: drexthealpha
