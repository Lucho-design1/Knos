{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.drexthealpha/knos",
  "description": "Knos carries research across the valley of death: each step is paid only on verified proof.",
  "repository": {
    "url": "https://github.com/drexthealpha/Knos",
    "source": "github"
  },
  "version": "0.4.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "knos",
      "version": "0.4.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://knos.onrender.com/mcp"
    }
  ]
}
