/src/knos/money/                @drexthealpha
/src/knos/graduation/           @drexthealpha
/src/knos/splits/               @drexthealpha
/src/knos/billing.py            @drexthealpha
/src/knos/fees.py               @drexthealpha
/src/knos/agentkey.py           @drexthealpha
/config/                        @drexthealpha

# The public record and the self-improvement loop's own code and config
/src/knos/record/               @drexthealpha
/src/knos/self/                 @drexthealpha
/targets.yml                    @drexthealpha
/CODEOWNERS                     @drexthealpha

