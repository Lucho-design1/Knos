# Knos trusted core: only the founder changes these paths.
#
# With branch protection on main ("Require a pull request", "Require review from Code Owners", no bypass), a pull
# request that touches any path below cannot merge without the founder's review. `knos self` refuses an agent's pull
# request that touches one before any of its code runs (docs/reference/SELF.md). targets.yml lists the same paths
# under `core`; tests/test_self_trust.py keeps the two lists equal.
#
# Everything not listed here is product: site, SDK, CLI, docs, skills, adapters. Agents may change product paths.

# Solana programs and their interfaces
/programs/                      @drexthealpha
/programs-v2/                   @drexthealpha
/crates/                        @drexthealpha
/idl/                           @drexthealpha

# The referee: judge, cheat library, sealed-test runner, receipts
/src/knos/judge.py              @drexthealpha
/src/knos/referee/              @drexthealpha
/src/knos/cheats/               @drexthealpha
/src/knos/gate/                 @drexthealpha
/src/knos/receipt2/             @drexthealpha
/tests/bench_tamper/            @drexthealpha

# Money: settlement, treasury, escrow, fees, splits, keys
